<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DatasetStudio.WinForms</RootNamespace>
    <AssemblyName>DatasetStudio</AssemblyName>
    <ApplicationIcon>..\..\assets\科准LOGO白.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DatasetStudio.Core\DatasetStudio.Core.csproj" />
    <ProjectReference Include="..\DatasetStudio.Infrastructure\DatasetStudio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Pages\ClassificationPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Pages\ClassificationPage.Designer.cs"><DependentUpon>ClassificationPage.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Pages\ClassificationPage.resx"><DependentUpon>ClassificationPage.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Pages\RoiCalibrationPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Pages\RoiCalibrationPage.Designer.cs"><DependentUpon>RoiCalibrationPage.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Pages\RoiCalibrationPage.resx"><DependentUpon>RoiCalibrationPage.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Pages\ValidationPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Pages\ValidationPage.Designer.cs"><DependentUpon>ValidationPage.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Pages\ValidationPage.resx"><DependentUpon>ValidationPage.cs</DependentUpon></EmbeddedResource>

    <Compile Update="Pages\ExportPage.cs"><SubType>UserControl</SubType></Compile>
    <Compile Update="Pages\ExportPage.Designer.cs"><DependentUpon>ExportPage.cs</DependentUpon></Compile>
    <EmbeddedResource Update="Pages\ExportPage.resx"><DependentUpon>ExportPage.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>
